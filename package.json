{
  "name": "ao-mapper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "sniffer:dev": "dotnet run --project packages/sniffer/src/AoMapper.Sniffer.App --",
    "build": "pnpm --filter shared build && pnpm --parallel --filter \"!shared\" build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
